  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget { background:#111722; color:#dce5f3; font:10pt &quot;Microsoft YaHei UI&quot;; }
QMenuBar { background:#1b2230; color:#e7edf7; border-bottom:1px solid #3a465a; }
QMenuBar::item:selected { background:#2b374a; }
QToolBar { background:#1a2230; border-bottom:1px solid #3c485c; spacing:7px; padding:5px; }
QToolButton, QPushButton { background:#263247; border:1px solid #4b5b75; border-radius:5px; padding:5px 10px; color:#e8eef7; }
QToolButton:hover, QPushButton:hover { background:#33435c; border-color:#6f84a5; }
QToolButton:pressed, QPushButton:pressed { background:#1d2737; padding-top:6px; padding-bottom:4px; }
QPushButton#startReceiveButton { background:#0d9b52; border:2px solid #23c474; min-height:34px; font-weight:700; }
QPushButton#startReceiveButton:hover { background:#12b862; border-color:#42df8c; }
QPushButton#stopReceiveButton { background:#a93740; border:2px solid #d45b64; min-height:34px; font-weight:700; }
QPushButton#stopReceiveButton:hover { background:#c44752; border-color:#ef737c; }
QPushButton#stopReceiveButton:disabled { color:#7d8797; background:#222a38; border-color:#333d4d; }
QPushButton#saveScreenshotButton { background:#216b52; border:1px solid #3ba97f; color:#f3fff9; font-weight:700; padding:3px 9px; }
QPushButton#saveScreenshotButton:hover { background:#2b8566; border-color:#61cda4; }
QGroupBox { border:1px solid #3d485b; border-radius:7px; margin-top:12px; padding-top:8px; font-weight:600; }
QGroupBox::title { subcontrol-origin:margin; left:10px; padding:0 5px; color:#e8eef7; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #252e3e;
    border: 1px solid #49566c;
    border-radius: 4px;
    padding: 0px 4px;
    color: #e3eaf5;
}
QCheckBox, QRadioButton, QLabel { color:#dbe3ef; }
QTabWidget::pane { border:1px solid #3f4b60; background:#0b1018; }
QTabBar::tab { background:#202938; color:#dbe3ee; padding:8px 22px; border:1px solid #3b4658; }
QTabBar::tab:selected { background:#153b60; border-bottom:2px solid #2c9cf0; }
QFrame[plotArea=&quot;true&quot;] { background:#05080d; border:1px solid #384456; border-radius:4px; }
QLabel[plotTitle=&quot;true&quot;] { color:#8290a5; font:600 12pt &quot;Microsoft YaHei UI&quot;; }
QTableWidget { background:#151c27; alternate-background-color:#1c2532; gridline-color:#394456; color:#dce4ef; }
QHeaderView::section { background:#242d3d; color:#dce4ef; border:1px solid #3e495b; padding:4px; }
QPlainTextEdit { background:#0b1119; color:#21d76b; border:1px solid #3b4658; font:9pt &quot;Consolas&quot;; }
QScrollArea { border:0; background:transparent; }
QSplitter::handle { background:#303b4c; }
QStatusBar { background:#1b2331; color:#dce5f0; border-top:1px solid #3d485a; }

/* 左右参数面板 */
QWidget#leftPanel,
QWidget#rightPanel {
    background: #111722;
}

/* 分组框内部增加轻微层次 */
QGroupBox {
    background: #171f2c;
    border: 1px solid #3d485b;
    border-radius: 7px;
    margin-top: 14px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #f0f4fa;
    background: #111722;
}

/* 禁用状态 */
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QPushButton:disabled {
    color: #788395;
    background: #1b2230;
    border-color: #333d4d;
}

QCheckBox:disabled,
QRadioButton:disabled,
QLabel:disabled {
    color: #6f7a8b;
}

/* 输入框获得焦点时使用蓝色边框 */
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #2c9cf0;
}</string>
